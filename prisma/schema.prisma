generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                   String            @id @default(cuid())
  number               Int               @unique @default(autoincrement())
  name                 String
  email                String            @unique
  emailVerifiedAt      DateTime?
  image                String?
  role                 UserRole          @default(USER)
  sessions             Session[]
  accounts             Account[]
  ownedPartners        Partner[]         @relation("OwnedPartners")
  receivedPartnerLinks PartnerUserLink[] @relation("ReceivedPartnerLinks")
  buckets              Bucket[]
  bookingAccounts      BookingAccount[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  number                Int       @unique @default(autoincrement())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  number      Int    @unique @default(autoincrement())
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum PartnerType {
  NATURAL_PERSON
  LEGAL_ENTITY
}

enum PartnerLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

model Partner {
  id          String           @id @default(cuid())
  number      Int              @unique @default(autoincrement())
  type        PartnerType
  name        String
  email       String?
  notes       String?
  contactLink String?
  ownerId     String
  owner       User             @relation("OwnedPartners", fields: [ownerId], references: [id], onDelete: Cascade)
  userLink    PartnerUserLink?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([ownerId])
}

model PartnerUserLink {
  id           String            @id @default(cuid())
  number       Int               @unique @default(autoincrement())
  partnerId    String            @unique
  partner      Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  linkedUserId String
  linkedUser   User              @relation("ReceivedPartnerLinks", fields: [linkedUserId], references: [id], onDelete: Cascade)
  status       PartnerLinkStatus @default(PENDING)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([linkedUserId, status])
}

enum BookingAccountType {
  LIQUID_ASSETS
  RECEIVABLES
  PREPAYMENTS
  OTHER_CURRENT_ASSETS
  NON_CURRENT_ASSETS
  LIABILITIES
  EQUITY
  INCOME
  EXPENSES
}

model Bucket {
  id               String         @id @default(cuid())
  number           Int            @unique @default(autoincrement())
  name             String
  currency         String         @default("EUR") @db.VarChar(3)
  notes            String?
  position         Int            @default(0)
  ownerId          String
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bookingAccountId String         @unique
  bookingAccount   BookingAccount @relation(fields: [bookingAccountId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerId])
}

model BookingAccountTemplate {
  id                   String                   @id @default(cuid())
  number               Int                      @unique @default(autoincrement())
  code                 String                   @unique
  name                 String
  description          String?
  type                 BookingAccountType
  isArchived           Boolean                  @default(false)
  isPostable           Boolean                  @default(true)
  allowsCustomChildren Boolean                  @default(false)
  position             Int                      @default(0)
  parentId             String?
  parent               BookingAccountTemplate?  @relation("BookingAccountTemplateHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             BookingAccountTemplate[] @relation("BookingAccountTemplateHierarchy")
  bookingAccounts      BookingAccount[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([parentId])
}

model BookingAccount {
  id          String                  @id @default(cuid())
  number      Int                     @unique @default(autoincrement())
  name        String
  type        BookingAccountType
  description String?
  isArchived  Boolean                 @default(false)
  isPostable  Boolean                 @default(true)
  position    Int                     @default(0)
  ownerId     String
  owner       User                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  templateId  String?
  template    BookingAccountTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  parentId    String?
  parent      BookingAccount?         @relation("BookingAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    BookingAccount[]        @relation("BookingAccountHierarchy")
  bucket      Bucket?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([ownerId, templateId])
  @@index([templateId])
  @@index([ownerId, type])
  @@index([parentId])
}
