generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(cuid())
  number               Int               @unique @default(autoincrement())
  name                 String
  email                String            @unique
  emailVerifiedAt      DateTime?
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  accounts             Account[]
  ownedPartners        Partner[]         @relation("OwnedPartners")
  receivedPartnerLinks PartnerUserLink[] @relation("ReceivedPartnerLinks")
}

model Session {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  number                Int       @unique @default(autoincrement())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Salted password hash for the user's credential account, never plaintext.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  number      Int    @unique @default(autoincrement())
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum PartnerType {
  NATURAL_PERSON
  LEGAL_ENTITY
}

enum PartnerLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

model Partner {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  type        PartnerType
  name        String
  email       String?
  notes       String?
  contactLink String?

  ownerId String
  owner   User   @relation("OwnedPartners", fields: [ownerId], references: [id], onDelete: Cascade)

  userLink PartnerUserLink?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model PartnerUserLink {
  id           String  @id @default(cuid())
  number       Int     @unique @default(autoincrement())
  partnerId    String  @unique
  partner      Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  linkedUserId String
  linkedUser   User    @relation("ReceivedPartnerLinks", fields: [linkedUserId], references: [id], onDelete: Cascade)

  status     PartnerLinkStatus @default(PENDING)
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkedUserId, status])
}
